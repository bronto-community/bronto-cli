# Local test environment. Copy to .env.local (gitignored) and fill in:
#   cp .env.local.example .env.local
# Everything here points at a Bronto org that tests are allowed to change:
# the shared CI test org, or a free-trial org of your own. Never your
# production org. See CONTRIBUTING.md#local-test-environment.

# Region of the test org: eu or us.
BRONTO_IT_REGION=eu

# The org's id, from the app URL: https://app.eu.bronto.io/org/<id>/...
BRONTO_IT_ORG_ID=

# API key with the AdminApi, SearchApi and IngestionApi roles.
# scripts/test-env also uses it as BRONTO_API_KEY for plain bronto commands.
BRONTO_IT_MGMT_KEY=

# API key with ONLY the IngestionApi role. Optional: without it the
# ingestion-key tests in integration/ skip themselves.
BRONTO_IT_INGEST_KEY=

# Port for the test browser's remote debugging (scripts/test-browser and
# .mcp.json). Change both if 9222 is taken.
BRONTO_TEST_CDP_PORT=9222
